# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# Server Configuration
PORT=3001

# Google OAuth Configuration
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
SESSION_SECRET=your-session-secret-key

# MongoDB Configuration
MONGO_URI=
# Required only when running the local MongoDB Compose service.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Environment Configuration
NODE_ENV=development

# Frontend URLs (for OAuth callback)
# Development: http://localhost:3000
# Production: https://examtopics-practice.onrender.com
FRONTEND_URL=http://localhost:3000
# The API accepts credentialed browser requests only from FRONTEND_URL's origin
# (plus localhost:3000/3001 outside production).

# Google OAuth callback (production only; development uses http://localhost:PORT/auth/google/callback)
# Production: https://<api-host>/auth/google/callback
GOOGLE_CALLBACK_URL=

# Reverse proxy (optional)
# Number of trusted reverse proxy hops in front of the API (1-5), e.g. 1 behind Caddy on staging.
# Leave empty when clients connect directly or the hop count is not verified.
TRUST_PROXY=
